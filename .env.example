ADMIN_EMAIL=admin@pecostoresound.com
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO_DE_32_CARACTERES
# Opcional para subir imágenes desde el panel
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
